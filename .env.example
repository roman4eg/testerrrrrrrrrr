# Predict Fun API Configuration
API_KEY=your_api_key_here

# JWT Token for authenticated operations (viewing orders, canceling)
# Get this by signing a message with your wallet
JWT=your_jwt_token_here

# Predict Account Address (deposit address) - це ваш основний акаунт в Predict Fun
# Можна знайти в налаштуваннях профілю на predict.fun
# Приклад: 0xAC12Ef1beDE880D2cDaE2f5285b2baa96403Cc41
PREDICT_ACCOUNT_ADDRESS=your_predict_account_address_here

# Privy Wallet Private Key - використовується для підписів (НЕ MetaMask ключ!)
# Отримати: predict.fun → Settings → Advanced → Export Privy Wallet
# ВАЖЛИВО: Тримайте цей ключ в безпеці! Ніколи не діліться ним!
# Format: 0x... (64 hex characters after 0x)
PRIVATE_KEY=your_privy_wallet_private_key_here

# Telegram Bot Configuration (опціонально, для --monitor-orders)
# 1. Створіть бота через @BotFather в Telegram
# 2. Скопіюйте токен і вставте нижче
# 3. Напишіть вашому боту /start
# 4. Отримайте ваш chat_id (можна через @userinfobot)
# 5. Скопіюйте chat_id і вставте нижче
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your_chat_id_here
